FROM python:3.11-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc libc-dev iputils-ping && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . /app/backend/
WORKDIR /app/backend

RUN mkdir -p data

EXPOSE 8000

CMD ["sh", "-c", "python manage.py migrate && uvicorn noc_project.asgi:app --host 0.0.0.0 --port 8000 --workers 1 --no-access-log"]